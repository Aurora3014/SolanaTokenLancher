# ---------- Server ----------
PORT=4000
# Keep 127.0.0.1: the API has no auth and holds private keys.
HOST=127.0.0.1
# Wallet keys + launch history are stored here (plain JSON - back it up, never commit it)
DATA_DIR=./data

# ---------- Network ----------
# devnet | mainnet-beta | forknet (a mainnet fork such as Surfpool; supports airdrops + bundles).
# pump.fun is not deployed on testnet.
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Optional websocket endpoint (defaults to the RPC_URL equivalent)
WS_URL=

# ---------- Wallets ----------
# How many wallets the "Generate wallets" button creates
WALLET_COUNT=5
# "Fund wallets" tops each generated wallet up to this SOL balance from the main wallet
FUND_AMOUNT_SOL=0.12
# SOL airdropped from the RPC faucet to each new wallet right after "Generate wallets".
# Works on devnet faucets / local forks (surfpool). 0 = off. Ignored on mainnet.
AIRDROP_AMOUNT_SOL=5

# ---------- Launch / buys ----------
# SOL the main (creator) wallet buys first, right after the create. 0 = no dev buy
DEV_BUY_AMOUNT_SOL=0.1
# SOL each generated wallet buys
BUY_AMOUNT_SOL=0.1
# Max extra SOL a buy may cost vs the quote, in percent
SLIPPAGE_PERCENT=15
# Delay between buys in ms. Sequential mode: between each wallet. Jito mode: between bundles
BUY_DELAY_MS=0
# Max generated wallets packed into one transaction (Jito mode only, 1-4).
# Transactions are split automatically when they would exceed the size limit (~2 buys fit).
BUYERS_PER_TX=3
# Priority fee in micro-lamports per compute unit
PRIORITY_FEE_MICROLAMPORTS=100000

# ---------- Jito bundle ----------
# true = create + buys land atomically in Jito bundles (same slot per bundle).
#   mainnet-beta / testnet: Jito's block engine.  forknet: the fork's RPC must accept sendBundle (Surfpool does).
# false = create is sent first, then buys right after it confirms.
JITO_ENABLED=false
# Empty = default for SOLANA_CLUSTER: Jito mainnet/testnet block engine, or RPC_URL on forknet.
JITO_BLOCK_ENGINE_URL=
JITO_TIP_SOL=0.001

# ---------- Metadata ----------
PUMP_IPFS_URL=https://pump.fun/api/ipfs
# auto = upload to pump.fun IPFS; if that fails (off mainnet) host the image + JSON on this server
# pumpfun = pump.fun IPFS only; local = always host on this server
METADATA_UPLOAD=auto
# Base URL put into locally hosted metadata URIs (default http://HOST:PORT)
PUBLIC_URL=
